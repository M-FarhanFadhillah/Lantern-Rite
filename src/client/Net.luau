--!native
--!optimize 2
--!nocheck
--!nolint
--#selene: allow(unused_variable, global_usage)
-- Client generated by Zap v0.6.29 (https://github.com/red-blox/zap)
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
if RunService:IsServer() and RunService:IsRunning() then
	error("Cannot use the client module on the server!")
end

if not _G.__ZAP then
	_G.__ZAP = { ["ZAP"] = {} }
elseif not _G.__ZAP["ZAP"] then
	_G.__ZAP["ZAP"] = {}
elseif _G.__ZAP["ZAP"]["ZAP"] ~= nil then
	error(`There is already an instance of Zap with the same remote_scope of ZAP, remote_folder of ZAP and the version of {_G.__ZAP["ZAP"]["ZAP"]}. Change the remote_scope or remote_folder option of both Zap instances`)
end

_G.__ZAP["ZAP"]["ZAP"] = "0.6.29"

local outgoing_buff: buffer
local outgoing_used: number
local outgoing_size: number
local outgoing_inst: { Instance }
local outgoing_apos: number
local outgoing_ids: { number }

local incoming_buff: buffer
local incoming_read: number
local incoming_inst: { Instance }
local incoming_ipos: number
local incoming_ids: { number }

-- thanks to https://dom.rojo.space/binary.html#cframe
local CFrameSpecialCases = {
	CFrame.Angles(0, 0, 0),
	CFrame.Angles(math.rad(90), 0, 0),
	CFrame.Angles(0, math.rad(180), math.rad(180)),
	CFrame.Angles(math.rad(-90), 0, 0),
	CFrame.Angles(0, math.rad(180), math.rad(90)),
	CFrame.Angles(0, math.rad(90), math.rad(90)),
	CFrame.Angles(0, 0, math.rad(90)),
	CFrame.Angles(0, math.rad(-90), math.rad(90)),
	CFrame.Angles(math.rad(-90), math.rad(-90), 0),
	CFrame.Angles(0, math.rad(-90), 0),
	CFrame.Angles(math.rad(90), math.rad(-90), 0),
	CFrame.Angles(0, math.rad(90), math.rad(180)),
	CFrame.Angles(0, math.rad(-90), math.rad(180)),
	CFrame.Angles(0, math.rad(180), math.rad(0)),
	CFrame.Angles(math.rad(-90), math.rad(-180), math.rad(0)),
	CFrame.Angles(0, math.rad(0), math.rad(180)),
	CFrame.Angles(math.rad(90), math.rad(180), math.rad(0)),
	CFrame.Angles(0, math.rad(0), math.rad(-90)),
	CFrame.Angles(0, math.rad(-90), math.rad(-90)),
	CFrame.Angles(0, math.rad(-180), math.rad(-90)),
	CFrame.Angles(0, math.rad(90), math.rad(-90)),
	CFrame.Angles(math.rad(90), math.rad(90), 0),
	CFrame.Angles(0, math.rad(90), 0),
	CFrame.Angles(math.rad(-90), math.rad(90), 0),
}

local function alloc(len: number)
	if outgoing_used + len > outgoing_size then
		while outgoing_used + len > outgoing_size do
			outgoing_size = outgoing_size * 2
		end

		local new_buff = buffer.create(outgoing_size)
		buffer.copy(new_buff, 0, outgoing_buff, 0, outgoing_used)

		outgoing_buff = new_buff
	end

	outgoing_apos = outgoing_used
	outgoing_used = outgoing_used + len

	return outgoing_apos
end

local function read(len: number)
	local pos = incoming_read
	incoming_read = incoming_read + len

	return pos
end

local function save()
	return {
		buff = outgoing_buff,
		used = outgoing_used,
		size = outgoing_size,
		inst = outgoing_inst,
		outgoing_ids = outgoing_ids,
		incoming_ids = incoming_ids,
	}
end

local function load(data: {
	buff: buffer,
	used: number,
	size: number,
	inst: { Instance },
	outgoing_ids: { number },
	incoming_ids: { number },
})
	outgoing_buff = data.buff
	outgoing_used = data.used
	outgoing_size = data.size
	outgoing_inst = data.inst
	outgoing_ids = data.outgoing_ids
	incoming_ids = data.incoming_ids
end

local function load_empty()
	outgoing_buff = buffer.create(64)
	outgoing_used = 0
	outgoing_size = 64
	outgoing_inst = {}
	outgoing_ids = {}
	incoming_ids = {}
end

load_empty()

local types = {}

local polling_queues_reliable = {}
local polling_queues_unreliable = {}
if not RunService:IsRunning() then
	local noop = function() end
	return table.freeze({
		SendEvents = noop,
		RequestCast = table.freeze({
			Fire = noop
		}),
		ReelIn = table.freeze({
			Fire = noop
		}),
		Hook = table.freeze({
			Fire = noop
		}),
		FishResult = table.freeze({
			SetCallback = noop
		}),
		CastResult = table.freeze({
			SetCallback = noop
		}),
		Bite = table.freeze({
			SetCallback = noop
		}),
	}) :: Events
end
local remotes = ReplicatedStorage:WaitForChild("ZAP")

local reliable = remotes:WaitForChild("ZAP_RELIABLE")
assert(reliable:IsA("RemoteEvent"), "Expected ZAP_RELIABLE to be a RemoteEvent")


local function SendEvents()
	if outgoing_used ~= 0 then
		local buff = buffer.create(outgoing_used)
		buffer.copy(buff, 0, outgoing_buff, 0, outgoing_used)

		reliable:FireServer(buff, outgoing_inst)

		outgoing_buff = buffer.create(64)
		outgoing_used = 0
		outgoing_size = 64
		table.clear(outgoing_inst)
	end
end

RunService.Heartbeat:Connect(SendEvents)

local reliable_events = table.create(3)
local reliable_event_queue: { [number]: { any } } = table.create(3)
reliable_event_queue[2] = {}
reliable_event_queue[0] = {}
reliable_event_queue[1] = {}
reliable.OnClientEvent:Connect(function(buff, inst)
	incoming_buff = buff
	incoming_inst = inst
	incoming_read = 0
	incoming_ipos = 0
	local len = buffer.len(buff)
	while incoming_read < len do
		local id = buffer.readu8(buff, read(1))
		if id == 2 then -- FishResult
			local value
			local bool_1 = buffer.readu8(incoming_buff, read(1))
			value = {  }
			if bit32.btest(bool_1, 0b0000000000000001) then
				value["outcome"] = "Caught"
			elseif bit32.btest(bool_1, 0b0000000000000010) then
				value["outcome"] = "Missed"
			elseif bit32.btest(bool_1, 0b0000000000000100) then
				value["outcome"] = "Escaped"
			elseif bit32.btest(bool_1, 0b0000000000001000) then
				value["outcome"] = "ReeledIn"
			end
			if bit32.btest(bool_1, 0b0000000000010000) then
				local len_1 = buffer.readu8(incoming_buff, read(1))
				assert(len_1 <= 160, "value is more than 160!")
				value["speciesId"] = buffer.readstring(incoming_buff, read(len_1), len_1)
				assert(utf8.len(value["speciesId"]) ~= nil, "value is not valid utf-8")
			else
				value["speciesId"] = nil
			end
			if bit32.btest(bool_1, 0b0000000000100000) then
				value["weightKg"] = buffer.readf32(incoming_buff, read(4))
			else
				value["weightKg"] = nil
			end
			if reliable_events[2] then
				task.spawn(reliable_events[2], value)
			else
				table.insert(reliable_event_queue[2], value)
				if #reliable_event_queue[2] > 64 then
					warn(`[ZAP] {#reliable_event_queue[2]} events in queue for FishResult. Did you forget to attach a listener?`)
				end
			end
		elseif id == 0 then -- CastResult
			local value, value2
			local bool_2 = buffer.readu8(incoming_buff, read(1))
			if bit32.btest(bool_2, 0b0000000000000001) then
				value = "Ok"
			elseif bit32.btest(bool_2, 0b0000000000000010) then
				value = "NotWater"
			elseif bit32.btest(bool_2, 0b0000000000000100) then
				value = "Busy"
			elseif bit32.btest(bool_2, 0b0000000000001000) then
				value = "Cooldown"
			elseif bit32.btest(bool_2, 0b0000000000010000) then
				value = "NoCharacter"
			elseif bit32.btest(bool_2, 0b0000000000100000) then
				value = "Invalid"
			end
			if bit32.btest(bool_2, 0b0000000001000000) then
				value2 = Vector3.new(buffer.readf32(incoming_buff, read(4)), buffer.readf32(incoming_buff, read(4)), buffer.readf32(incoming_buff, read(4)))
			else
				value2 = nil
			end
			if reliable_events[0] then
				task.spawn(reliable_events[0], value, value2)
			else
				table.insert(reliable_event_queue[0], { value, value2 })
				if #reliable_event_queue[0] > 64 then
					warn(`[ZAP] {#reliable_event_queue[0]} events in queue for CastResult. Did you forget to attach a listener?`)
				end
			end
		elseif id == 1 then -- Bite
			local value
			local len_2 = buffer.readu8(incoming_buff, read(1))
			assert(len_2 <= 160, "value is more than 160!")
			value = buffer.readstring(incoming_buff, read(len_2), len_2)
			assert(utf8.len(value) ~= nil, "value is not valid utf-8")
			if reliable_events[1] then
				task.spawn(reliable_events[1], value)
			else
				table.insert(reliable_event_queue[1], value)
				if #reliable_event_queue[1] > 64 then
					warn(`[ZAP] {#reliable_event_queue[1]} events in queue for Bite. Did you forget to attach a listener?`)
				end
			end
		else
			error("Unknown event id")
		end
	end
end)
table.freeze(polling_queues_reliable)
table.freeze(polling_queues_unreliable)

local returns = {
	SendEvents = SendEvents,
	RequestCast = {
		Fire = function(power: (number), direction: (Vector3))
			alloc(1)
			buffer.writeu8(outgoing_buff, outgoing_apos, 0)
			assert(power >= 0, "value is less than 0!")
			assert(power <= 1, "value is more than 1!")
			alloc(4)
			buffer.writef32(outgoing_buff, outgoing_apos, power)
			alloc(4)
			buffer.writef32(outgoing_buff, outgoing_apos, direction.X)
			alloc(4)
			buffer.writef32(outgoing_buff, outgoing_apos, direction.Y)
			alloc(4)
			buffer.writef32(outgoing_buff, outgoing_apos, direction.Z)
		end,
	},
	ReelIn = {
		Fire = function()
			alloc(1)
			buffer.writeu8(outgoing_buff, outgoing_apos, 2)
		end,
	},
	Hook = {
		Fire = function(token: (string))
			alloc(1)
			buffer.writeu8(outgoing_buff, outgoing_apos, 1)
			local len_3 = #token
			assert(len_3 <= 160, "value is more than 160!")
			assert(utf8.len(token) ~= nil, "value is not valid utf-8")
			alloc(1)
			buffer.writeu8(outgoing_buff, outgoing_apos, len_3)
			alloc(len_3)
			buffer.writestring(outgoing_buff, outgoing_apos, token, len_3)
		end,
	},
	FishResult = {
		SetCallback = function(Callback: (Value: ({
			["outcome"]: ("Caught" | "Missed" | "Escaped" | "ReeledIn"),
			["speciesId"]: ((string)?),
			["weightKg"]: ((number)?),
		})) -> ()): () -> ()
			reliable_events[2] = Callback
			for _, value in reliable_event_queue[2] do
				task.spawn(Callback, value)
			end
			reliable_event_queue[2] = {}
			return function()
				reliable_events[2] = nil
			end
		end,
	},
	CastResult = {
		SetCallback = function(Callback: (reason: ("Ok" | "NotWater" | "Busy" | "Cooldown" | "NoCharacter" | "Invalid"), landing: ((Vector3)?)) -> ()): () -> ()
			reliable_events[0] = Callback
			for _, value in reliable_event_queue[0] do
				task.spawn(Callback, unpack(value))
			end
			reliable_event_queue[0] = {}
			return function()
				reliable_events[0] = nil
			end
		end,
	},
	Bite = {
		SetCallback = function(Callback: (token: (string)) -> ()): () -> ()
			reliable_events[1] = Callback
			for _, value in reliable_event_queue[1] do
				task.spawn(Callback, value)
			end
			reliable_event_queue[1] = {}
			return function()
				reliable_events[1] = nil
			end
		end,
	},
}
type Events = typeof(returns)
return returns
