-- Remotes, generated by Zap into src/server/Net.luau and src/client/Net.luau (run `zap net.zap`).
-- Clients send only aim, cast power, the bite token and reel-in. The server decides the landing
-- point, spot, fish, bite time and hook outcome (PRD §4, §14).

opt server_output = "src/server/Net.luau"
opt client_output = "src/client/Net.luau"

event RequestCast = {
	from: Client,
	type: Reliable,
	call: SingleAsync,
	data: (power: f32(0..1), direction: Vector3),
}

event CastResult = {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (reason: enum { "Ok", "NotWater", "Busy", "Cooldown", "NoCharacter", "Invalid" }, landing: Vector3?),
}

event Bite = {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (token: string.utf8(..40)),
}

event Hook = {
	from: Client,
	type: Reliable,
	call: SingleAsync,
	data: (token: string.utf8(..40)),
}

event ReelIn = {
	from: Client,
	type: Reliable,
	call: SingleAsync,
}

event FishResult = {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: struct {
		outcome: enum { "Caught", "Missed", "Escaped", "ReeledIn" },
		speciesId: string.utf8(..40)?,
		weightKg: f32?,
	},
}
